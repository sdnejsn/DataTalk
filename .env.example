# Select one preset: deepseek, openai, qwen, moonshot, zhipu, siliconflow,
# openrouter, gemini, custom. Keep credentials in this local file only.
API_PROVIDER=
API_KEY=

# Optional for presets: their default endpoint and model are used when blank.
# Required for API_PROVIDER=custom.
API_BASE_URL=
API_MODEL=
API_TIMEOUT_SECONDS=90
API_MAX_TOKENS=4096

# Initial execution plus at most two correction attempts.
DATATALK_MAX_RETRIES=2
DATATALK_EXECUTION_TIMEOUT_SECONDS=30
DATATALK_OUTPUT_DIR=outputs

# Only schema and row count are sent by default. Enable sample rows explicitly.
DATATALK_SAMPLE_ROWS=0
DATATALK_MAX_CSV_MB=20
DATATALK_MAX_ROWS=100000
